# --- Tout ce qui est installé ou produit localement, à recréer avec setup.cmd ---

# Environnements Python du projet (application et moteur d'analyse)
.venv/
.venv-engine/
venv/
env/

# Code et poids du moteur Rec-RIR (dépôt tiers, ~48 Mo) : recloné par setup.cmd
third_party/

# Données de travail, exports et journaux du service
data/
.engine-logs/
exports/

# Caches Python et outils
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Configuration d'outils de développement, sans rôle dans le programme
.claude/
.vscode/
.idea/

# Fichiers système
Thumbs.db
desktop.ini
.DS_Store

# Audio et tableaux : ne jamais publier de rushes ni de résultats de banc
*.wav
*.npy
*.npz
!tests/fixtures/*.wav
# Seul média livré : prototype silencieux du template Pro Tools.
!src/mimetic/resources/Audio Files/Mimetic_Prototype_Float32_TC_60s.wav

# Les sources Mac et releases sont versionnées; les snapshots et essais restent locaux.
/macos-portable/.test-venv/
/macos-portable/.build-venv/
/macos-portable/payload/
/macos-portable/transfer/
# IR de contrôle issue d'une entrée synthétique, sans dialogue de production.
!macos-portable/validation/engine_baseline.npy
